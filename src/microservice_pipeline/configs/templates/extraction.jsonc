{
  // Extraction config for:
  // - microservice-pipeline call-graph
  // - microservice-pipeline data-access
  // - microservice-pipeline infer-shared-containers
  //
  // This file is JSONC: normal JSON plus // comments, /* block comments */,
  // and trailing commas. `init-config` rewrites project_root so it points from
  // the generated config directory back to the analyzed project.

  // All source and artifact paths below resolve from this project root.
  "project_root": ".",

  "source": {
    // Scan one or more source trees. Use module_prefix when the source root is
    // already inside a package, for example path "src/shop" and prefix "shop".
    "roots": [
      {
        "path": "src",
        "module_prefix": null,
      }
    ],

    // Keep only calls within these package namespaces. Leave empty to avoid
    // package-prefix filtering.
    "package_prefixes": [],

    // Additional Python files outside the scanned roots, such as scripts that
    // assemble and run the application.
    "entrypoints": [],

    // Include and exclude globs can match source-root-relative or
    // project-root-relative paths.
    "include_globs": ["**/*.py"],
    "exclude_globs": [
      "**/__pycache__/**",
      "**/.venv/**",
      "**/venv/**",
    ],
  },

  "call_graph": {
    // Keep unresolved and external calls as graph edges when true.
    "include_external": false,

    // Raw call graph artifacts: call_graph.json, nodes.csv, and edges.csv.
    "outdir": "artifacts/call_graph",

    // Installed third-party packages to read for registry evidence only, e.g.
    // ["torch", "sklearn"]. Frameworks couple objects by taking one and
    // invoking it later -- add_module, register, Pipeline(steps=[...]) --
    // and the method that does it lives in the framework, not here. Reading it
    // is what lets those calls become `registered_invoke` edges without anyone
    // naming the method. Nothing from these packages becomes a node or an edge;
    // only the facts are kept. Costs one extra parse of each package per run,
    // so list only frameworks whose objects this project actually registers.
    "summary_packages": [],

    // Optional runtime ground truth for `trace-runtime` and `compare-graphs`.
    // Each driver runs inside the pipeline process, because sys.monitoring
    // cannot observe a subprocess. Leave every list empty to skip tracing.
    "trace": {
      // Arguments passed to an in-process pytest run, e.g.
      // ["tests", "-m", "fast", "-q"]. Test failures are tolerated: a failing
      // test still contributes the edges it reached.
      "pytest_args": [],

      // Notebook globs, relative to project_root, e.g. ["courseware/*.ipynb"].
      // Code cells run one at a time in a shared namespace and a failing cell
      // does not abort the rest.
      "notebook_globs": [],

      // Plain Python scripts to execute as additional drivers.
      "scripts": [],

      // Consecutive hits at one call site without revealing a new callee
      // before that site stops being monitored. Higher costs more time but is
      // safer for highly polymorphic dispatch; 1 would report only the first
      // callee at every site.
      "disable_after": 20,
    },
  },

  "data_access": {
    // Raw data-access artifacts. Run extraction once without a shared mapping,
    // review inferred containers, then write accepted results to a separate
    // directory such as artifacts/data_access_inferred.
    "outdir": "artifacts/data_access",

    "pyright": {
      // Pyright improves container-family inference. Disable it when Pyright
      // is unavailable or when a dependency-light extraction is preferred.
      "enabled": true,

      // Executable or command name used to invoke Pyright.
      "bin": "pyright",

      // Options: fallback_unknown, error.
      "fail_policy": "fallback_unknown",
    },

    // Optional reviewed mapping, typically
    // configs/microservice_pipeline/shared_containers.jsonc. Keep null for
    // the initial raw extraction and pass an accepted mapping on the rerun.
    "shared_containers_config": null,

    // Draft mapping and review report written by infer-shared-containers.
    "inferred_shared_containers_config": "artifacts/inferred_shared_containers.json",
    "inferred_shared_containers_report": "artifacts/inferred_shared_containers.md",
  },
}
